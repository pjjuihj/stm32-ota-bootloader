; *************************************************************
; *** Scatter-Loading Description File - App (Partition A) ***
; *************************************************************

; App 从 Partition A (0x0800C000) 运行
; 最大 208KB (Sector 3-5)
; RAM: SRAM1 112KB + CCM 16KB

LR_IROM1 0x0800C000 0x00034000  {    ; 208KB Partition A
  ER_IROM1 0x0800C000 0x00034000  {  ; load address = execution address
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
   .ANY (+XO)
  }
  RW_IRAM1 0x20000000 0x00020000  {  ; 128KB Main SRAM (含 SRAM2)
   .ANY (+RW +ZI)
  }
}

